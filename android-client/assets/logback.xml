<configuration>
    <!-- LogcatAppender: 将日志输出到 Android Logcat -->
    <appender name="LOGCAT" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder>
            <!-- 使用 logger 名称作为 Logcat 的 tag，截取最后 23 个字符（Android tag 长度限制） -->
            <pattern>%logger{23}</pattern>
        </tagEncoder>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level --> %msg%n</pattern>
        </encoder>
    </appender>
    <!-- 根日志级别设为 INFO -->
    <root level="INFO">
        <appender-ref ref="LOGCAT"/>
    </root>
    <!-- 项目日志级别设为 DEBUG -->
    <logger name="dev.sunriseydy.acgn" level="DEBUG"/>
    <!-- Ktor 客户端日志级别设为 INFO -->
    <logger name="io.ktor" level="INFO"/>
</configuration>
