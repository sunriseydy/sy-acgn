# Anime
### create anime
# @no-log
POST http://localhost:9390/api/anime/anime/season
Content-Type: application/json
Accept: application/json

{
  "id": 0,
  "animeId": 0,
  "name": {{$random.alphabetic(10)}},
  "originalName": "test",
  "description": "test",
  "season": 1,
  "year": 2024,
  "month": 4,
  "startedAt": "2024-04-01T00:00:00.000Z",
  "endedAt": "2024-04-01T00:00:00.000Z",
  "tmdbId": {{$randomInt}},
  "bgmId": {{$randomInt}},
  "anime": {
    "id": 0,
    "name": {{$random.alphabetic(10)}},
    "originalName": "test",
    "description": "test",
    "tmdbId": {{$randomInt}},
    "bgmId": {{$randomInt}},
    "additions": [{
      "id": "",
      "associatedId": 0,
      "associatedType": "enum.ANIME.AnimeAssociatedType.ANIME",
      "additionalType": "addition.ANIME.TmdbJson",
      "additionalValue": "{\"id\": 1}"
    }]
  },
  "additions": [{
    "id": "",
    "associatedId": 0,
    "associatedType": "enum.ANIME.AnimeAssociatedType.ANIME_SEASON",
    "additionalType": "addition.ANIME.TmdbJson",
    "additionalValue": "{\"id\": 1}"
  }]
}

